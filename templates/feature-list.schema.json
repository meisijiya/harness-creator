{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Feature List",
  "description": "跟踪代理驱动开发的功能实现状态",
  "type": "object",
  "properties": {
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "唯一功能标识符（如 feat-001）",
            "pattern": "^feat-\\d+$"
          },
          "name": {
            "type": "string",
            "description": "简短的功能名称"
          },
          "description": {
            "type": "string",
            "description": "该功能做什么"
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "必须先于此功能完成的功能 ID"
          },
          "status": {
            "type": "string",
            "enum": ["not-started", "in-progress", "blocked", "done"],
            "description": "当前实现状态"
          },
          "evidence": {
            "type": "string",
            "description": "状态为 'done' 时的验证证据：命令与结果摘要，或 CI 检查 / PR 链接"
          }
        },
        "required": ["id", "name", "description", "status"]
      }
    }
  },
  "required": ["features"]
}
